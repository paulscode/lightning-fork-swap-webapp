{
    "name": "boltz-swaps",
    "version": "0.0.9",
    "description": "Swap SDK (submarine and reverse swaps, BTC only) for Lightning Fork Swap, derived from Boltz's boltz-swaps",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./types": {
            "source": "./src/types.ts",
            "types": "./dist/types.d.ts",
            "default": "./dist/types.js"
        },
        "./config": {
            "source": "./src/config.ts",
            "types": "./dist/config.d.ts",
            "default": "./dist/config.js"
        },
        "./logger": {
            "source": "./src/logger.ts",
            "types": "./dist/logger.d.ts",
            "default": "./dist/logger.js"
        },
        "./interfaces": {
            "source": "./src/interfaces/index.ts",
            "types": "./dist/interfaces/index.d.ts",
            "default": "./dist/interfaces/index.js"
        },
        "./cache": {
            "source": "./src/cache.ts",
            "types": "./dist/cache.d.ts",
            "default": "./dist/cache.js"
        },
        "./errors": {
            "source": "./src/errors.ts",
            "types": "./dist/errors.d.ts",
            "default": "./dist/errors.js"
        },
        "./helper": {
            "source": "./src/helper.ts",
            "types": "./dist/helper.d.ts",
            "default": "./dist/helper.js"
        },
        "./invoice": {
            "source": "./src/invoice.ts",
            "types": "./dist/invoice.d.ts",
            "default": "./dist/invoice.js"
        },
        "./resolveInvoice": {
            "source": "./src/resolveInvoice.ts",
            "types": "./dist/resolveInvoice.d.ts",
            "default": "./dist/resolveInvoice.js"
        },
        "./lnurl": {
            "source": "./src/lnurl.ts",
            "types": "./dist/lnurl.d.ts",
            "default": "./dist/lnurl.js"
        },
        "./client": {
            "source": "./src/client.ts",
            "types": "./dist/client.d.ts",
            "default": "./dist/client.js"
        },
        "./status": {
            "source": "./src/status.ts",
            "types": "./dist/status.d.ts",
            "default": "./dist/status.js"
        },
        "./statusSource": {
            "source": "./src/statusSource/index.ts",
            "types": "./dist/statusSource/index.d.ts",
            "default": "./dist/statusSource/index.js"
        },
        "./reverse": {
            "source": "./src/reverse.ts",
            "types": "./dist/reverse.d.ts",
            "default": "./dist/reverse.js"
        },
        "./submarine": {
            "source": "./src/submarine.ts",
            "types": "./dist/submarine.d.ts",
            "default": "./dist/submarine.js"
        },
        "./storage": {
            "source": "./src/storage/index.ts",
            "types": "./dist/storage/index.d.ts",
            "default": "./dist/storage/index.js"
        },
        "./lazy": {
            "source": "./src/lazy.ts",
            "types": "./dist/lazy.d.ts",
            "default": "./dist/lazy.js"
        },
        "./utxo": {
            "source": "./src/utxo/index.ts",
            "types": "./dist/utxo/index.d.ts",
            "default": "./dist/utxo/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rm -rf .tsbuildinfo dist/ && bun run tsc:bin",
        "dev": "bun run tsc:bin -- --watch",
        "tsc:bin": "node node_modules/typescript7/bin/tsc",
        "tsc": "bun run tsc:bin -- --noEmit && bun run tsc:bin -- --noEmit -p tests/tsconfig.json",
        "test": "vitest run",
        "check:lazy": "node scripts/check-eager-loads.mjs",
        "check:package": "node scripts/check-package-smoke.mjs",
        "prettier": "bunx prettier --cache src tests scripts *.json *.mjs",
        "prettier:write": "bun run prettier -- --write",
        "prettier:check": "bun run prettier -- --check",
        "lint": "eslint --max-warnings 0 --cache src scripts tests",
        "check": "bun run prettier:write && bun run lint -- --fix && bun run tsc"
    },
    "dependencies": {
        "@noble/curves": "catalog:",
        "@noble/hashes": "catalog:",
        "@scure/base": "catalog:"
    },
    "peerDependencies": {
        "@scure/btc-signer": "catalog:",
        "bolt11": "catalog:",
        "boltz-core": "catalog:"
    },
    "peerDependenciesMeta": {
        "@scure/btc-signer": {
            "optional": true
        },
        "bolt11": {
            "optional": true
        },
        "boltz-core": {
            "optional": true
        }
    },
    "devDependencies": {
        "boltz-core": "catalog:",
        "typescript7": "npm:typescript@^7.0.2",
        "vitest": "catalog:"
    },
    "private": true
}
