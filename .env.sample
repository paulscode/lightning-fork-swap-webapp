# Sample file containing all env variables
# Deployment-specific values should be set in .env.local

# Base URL of the swap API. Defaults to the origin the web app is served from
# on mainnet and to http://localhost:9001 on regtest
VITE_API_URL=

# Regtest only: Esplora-compatible explorer API and explorer web UI
VITE_EXPLORER_API_URL=
VITE_EXPLORER_URL=
