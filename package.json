{
    "name": "lightning-fork-swap-webapp",
    "version": "0.1.0",
    "description": "Lightning Fork Swap: non-custodial swaps between the Bitcoin BLAKE2b chain and its Lightning network (fork of the Boltz web app)",
    "workspaces": {
        "packages": [
            "packages/*"
        ],
        "catalog": {
            "@noble/curves": "^2.2.0",
            "@noble/hashes": "^2.2.0",
            "@scure/base": "^2.2.0",
            "@scure/btc-signer": "^2.2.0",
            "bignumber.js": "^11.1.5",
            "bolt11": "^1.4.1",
            "boltz-core": "^4.0.5",
            "vitest": "^4.1.10"
        }
    },
    "scripts": {
        "start": "bun run regtest && vite",
        "test": "bun run regtest && bun --filter boltz-swaps build && vitest run --dir ./tests && bun --filter boltz-swaps test",
        "dev": "vite",
        "preview": "vite preview",
        "build": "./build.py && vite build; cp dist/index.html dist/404.html",
        "build:regular": "node index-template-vars.mjs && bun run build",
        "mainnet": "cp src/configs/mainnet.ts src/config.ts",
        "regtest": "cp src/configs/regtest.ts src/config.ts",
        "postinstall": "bun run regtest",
        "prettier": "bunx prettier --cache src public tests .github packages *.ts *.mjs *.json *.html README.md",
        "prettier:write": "bun run prettier -- --write",
        "prettier:check": "bun run prettier -- --check",
        "check": "bun run prettier:write && bun run lint -- --fix && bun run lint:style -- --fix && bun run tsc",
        "tsc": "node node_modules/typescript7/bin/tsc",
        "lint": "eslint --max-warnings 0 --cache .",
        "lint:style": "stylelint --max-warnings 0 'src/**/*.scss'",
        "optimize:assets": "bun run optimize-assets.mjs",
        "check:assets": "bun run check-assets.mjs"
    },
    "devDependencies": {
        "@babel/parser": "^8.0.4",
        "@babel/traverse": "^8.0.4",
        "@eslint/js": "^10.0.1",
        "@solidjs/testing-library": "^0.8.10",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/user-event": "^14.6.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^25.9.3",
        "@types/qrcode": "^1.5.6",
        "@webbtc/webln-types": "^3.0.0",
        "axios": "^1.18.1",
        "eslint": "^9.39.4",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-solid": "^0.14.5",
        "globals": "^17.7.0",
        "jsdom": "^29.1.1",
        "magic-string": "^0.30.21",
        "prettier": "^3.9.4",
        "sass-embedded": "^1.99.0",
        "source-map-js": "^1.2.1",
        "stylelint": "^17.14.0",
        "stylelint-config-recommended-scss": "^17.0.1",
        "stylelint-declaration-strict-value": "^1.11.1",
        "svgo": "^4.0.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.63.0",
        "typescript7": "npm:typescript@^7.0.2",
        "vite": "^8.1.4",
        "vite-plugin-node-polyfills": "^0.28.0",
        "vite-plugin-solid": "^2.11.12",
        "vite-plugin-wasm": "^3.6.0",
        "vitest": "catalog:"
    },
    "dependencies": {
        "@fontsource/noto-mono": "^5.2.5",
        "@fontsource/noto-sans": "^5.2.10",
        "@noble/curves": "catalog:",
        "@noble/hashes": "catalog:",
        "@scure/base": "catalog:",
        "@scure/bip32": "^2.2.0",
        "@scure/bip39": "^2.2.0",
        "@scure/btc-signer": "catalog:",
        "@solid-primitives/i18n": "^2.2.1",
        "@solid-primitives/storage": "^4.3.5",
        "@solidjs/router": "^0.16.1",
        "bignumber.js": "catalog:",
        "bolt11": "catalog:",
        "boltz-core": "catalog:",
        "boltz-swaps": "workspace:*",
        "buffer": "^6.0.3",
        "localforage": "^1.10.0",
        "loglevel": "^1.9.2",
        "qr-scanner": "^1.4.2",
        "qrcode": "^1.5.4",
        "solid-icons": "^1.2.0",
        "solid-js": "^1.9.14"
    },
    "private": true,
    "license": "AGPL-3.0"
}
